<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:padding="8dp">

    <TextView
        android:id="@+id/imeStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="16sp"
        android:minHeight="32dp"
        android:text="@string/ime_idle" />

    <Button
        android:id="@+id/imeMicButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:textSize="18sp"
        android:text="@string/ime_mic_start" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/imeSwitchButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/ime_switch" />

        <Button
            android:id="@+id/imeSpaceButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:text="@string/ime_space" />

        <Button
            android:id="@+id/imeDeleteButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/ime_delete" />

        <Button
            android:id="@+id/imeEnterButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/ime_enter" />
    </LinearLayout>
</LinearLayout>
