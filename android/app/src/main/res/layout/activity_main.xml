<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_subtitle"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_idle"
            android:textSize="16sp"
            android:gravity="center"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/countsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/recordMeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_record_me" />

        <Button
            android:id="@+id/recordOtherButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_record_other" />

        <Button
            android:id="@+id/trainButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/button_train" />

        <Button
            android:id="@+id/liveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_live_start" />

        <ProgressBar
            android:id="@+id/probabilityBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/probabilityText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/probability_idle"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/resetButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/button_reset" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/ime_section_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/ime_section_hint"
            android:textSize="14sp"
            android:gravity="center" />

        <Button
            android:id="@+id/enableImeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_enable_ime" />

        <Button
            android:id="@+id/pickImeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_pick_ime" />

    </LinearLayout>
</ScrollView>
