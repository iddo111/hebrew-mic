{
  "auto_enter": false,
  "enter_delay": 0.07,
  "language": "he",
  "hotkey": "ctrl+shift+d",
  "ptt_hotkey": "ctrl+shift+space",
  "mode": "ptt",
  "mic_device": null,
  "mic_prefer_name": "USBAudio",
  "mic_blocklist": [
    "WH-1000XM4",
    "Headset",
    "Hands-Free",
    "Handsfree",
    "HFP",
    "HSP",
    "Loopback",
    "Virtual",
    "AudioRelay",
    "Stereo Mix",
    "What U Hear",
    "Speakers",
    "Sound Mapper"
  ],
  "wasapi_shared": true,
  "whisper_model": "ivrit-ai/whisper-large-v3-turbo-ct2",
  "whisper_device": "cuda",
  "silence_ms": 900,
  "energy_threshold": 0.006,
  "software_gain": 14.0,
  "dsp_enabled": true,
  "dsp_hpf_hz": 110.0,
  "dsp_notch_freqs": [50, 100, 150],
  "dsp_notch_q": 30.0,
  "dsp_noise_gate": 0.006,
  "no_speech_threshold": 0.65,
  "sample_rate": 16000,
  "http_port": 7788,
  "auto_enter_blocklist": [],
  "default_route": "smart",
  "listening": false,
  "_notes": "Copy this to dictation.json and tune for your machine. whisper_device 'cuda' (GPU) or 'cpu'. whisper_model: a HF faster-whisper/CT2 model id or a local path. mode 'ptt' (push-to-talk, hold ptt_hotkey) or 'always_on'. auto_enter only fires when the foreground window is Claude. default_route 'smart' = a leading 'קלוד'/'גרוק' routes to that window; otherwise text goes to the focused window."
}
